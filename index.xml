			<item>
				<title></title>
				<link>http://daihongyang.github.io/SWHY-love/moments/0613/</link>
				<pubDate>Sat, 13 Jun 2026 05:20:00 +0800</pubDate>
				<guid>http://daihongyang.github.io/SWHY-love/moments/0613/</guid>
				<description>&lt;p&gt;我们在一起啦！&lt;/p&gt;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&lt;div&#xA;    class=&#34;countdown-day&#34;&#xA;    id=&#34;countdown-a81fc8ee7b&#34;&#xA;    data-date=&#34;2026-06-13&#34;&#xA;    data-use-view-date=&#34;true&#34;&#xA;    data-range-start=&#34;&#34;&#xA;    data-range-end=&#34;&#34;&#xA;    data-title=&#34;我们在一起&#34;&#xA;    data-pub-date=&#34;2026-06-13&#34;&#xA;&gt;&#xA;    &lt;div class=&#34;memorial-header&#34;&gt;&#xA;        &lt;span class=&#34;countdown-title&#34;&gt;Calculating...&lt;/span&gt;&#xA;    &lt;/div&gt;&#xA;&#xA;    &lt;div class=&#34;memorial-counter&#34;&gt;&#xA;        &lt;div class=&#34;counter-number&#34;&gt;-&lt;/div&gt;&#xA;    &lt;/div&gt;&#xA;&#xA;    &lt;div class=&#34;memorial-footer&#34;&gt;&#xA;        &lt;div class=&#34;target-date&#34;&gt;&#xA;            &lt;span class=&#34;date-info&#34;&gt;Calculating...&lt;/span&gt;&#xA;        &lt;/div&gt;&#xA;    &lt;/div&gt;&#xA;&lt;/div&gt;&#xA;&#xA;&lt;script&gt;&#xA;(function() {&#xA;    const widget = document.currentScript ? document.currentScript.previousElementSibling : null;&#xA;    const widgetId = widget ? widget.id : &#39;&#39;;&#xA;    const date = widget ? widget.dataset.date || &#39;&#39; : &#39;&#39;;&#xA;    const useViewDate = widget ? widget.dataset.useViewDate === &#39;true&#39; : false;&#xA;    const rangeStart = widget ? widget.dataset.rangeStart || &#39;&#39; : &#39;&#39;;&#xA;    const rangeEnd = widget ? widget.dataset.rangeEnd || &#39;&#39; : &#39;&#39;;&#xA;    const title = widget ? widget.dataset.title || &#39;目标日期&#39; : &#39;目标日期&#39;;&#xA;    const pubDate = widget ? widget.dataset.pubDate || &#39;&#39; : &#39;&#39;;&#xA;&#xA;    &#xA;    &#xA;    &#xA;    &#xA;    &#xA;    &#xA;    &#xA;    &#xA;    &#xA;&#xA;    function parseFixedDate(dateStr) {&#xA;        if (!dateStr) {&#xA;            return null;&#xA;        }&#xA;&#xA;        const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(dateStr);&#xA;        if (!match) {&#xA;            return null;&#xA;        }&#xA;&#xA;        const year = Number(match[1]);&#xA;        const month = Number(match[2]);&#xA;        const day = Number(match[3]);&#xA;        const parsed = new Date(year, month - 1, day);&#xA;&#xA;        if (&#xA;            parsed.getFullYear() !== year ||&#xA;            parsed.getMonth() !== month - 1 ||&#xA;            parsed.getDate() !== day&#xA;        ) {&#xA;            return null;&#xA;        }&#xA;&#xA;        return parsed;&#xA;    }&#xA;&#xA;    function getTodayDate() {&#xA;        const now = new Date();&#xA;        return new Date(now.getFullYear(), now.getMonth(), now.getDate());&#xA;    }&#xA;&#xA;    function getDaysDifference(date1, date2) {&#xA;        const d1 = new Date(date1.getFullYear(), date1.getMonth(), date1.getDate());&#xA;        const d2 = new Date(date2.getFullYear(), date2.getMonth(), date2.getDate());&#xA;        const diffInMs = d2.getTime() - d1.getTime();&#xA;        return Math.floor(diffInMs / (1000 * 60 * 60 * 24));&#xA;    }&#xA;&#xA;    function formatDateInfo(date, label) {&#xA;        const year = date.getFullYear();&#xA;        const month = String(date.getMonth() + 1).padStart(2, &#39;0&#39;);&#xA;        const day = String(date.getDate()).padStart(2, &#39;0&#39;);&#xA;&#xA;        if (!label) {&#xA;            return `${year}-${month}-${day}`;&#xA;        }&#xA;&#xA;        return `${label}(${year}-${month}-${day})`;&#xA;    }&#xA;&#xA;    function adjustFontSize(element) {&#xA;        const container = element.parentElement;&#xA;        const containerWidth = container.clientWidth - 20;&#xA;        let fontSize = 120;&#xA;&#xA;        element.style.fontSize = fontSize + &#39;px&#39;;&#xA;&#xA;        while (element.scrollWidth &gt; containerWidth &amp;&amp; fontSize &gt; 80) {&#xA;            fontSize -= 10;&#xA;            element.style.fontSize = fontSize + &#39;px&#39;;&#xA;        }&#xA;&#xA;        while (element.scrollWidth &lt; containerWidth &amp;&amp; fontSize &lt; 120) {&#xA;            const testSize = fontSize + 0.5;&#xA;            element.style.fontSize = testSize + &#39;px&#39;;&#xA;&#xA;            if (element.scrollWidth &gt; containerWidth) {&#xA;                element.style.fontSize = fontSize + &#39;px&#39;;&#xA;                break;&#xA;            }&#xA;&#xA;            fontSize = testSize;&#xA;        }&#xA;    }&#xA;&#xA;    function getConfig() {&#xA;        const hasDate = Boolean(date);&#xA;        const hasRangeStart = Boolean(rangeStart);&#xA;        const hasRangeEnd = Boolean(rangeEnd);&#xA;        const hasRange = hasRangeStart || hasRangeEnd;&#xA;&#xA;        &#xA;        &#xA;        &#xA;        &#xA;        &#xA;        &#xA;&#xA;        if (hasDate &amp;&amp; hasRange) {&#xA;            &#xA;            return { error: &#39;date 和 rangeStart/rangeEnd 不能同时使用&#39; };&#xA;        }&#xA;&#xA;        if (!hasDate &amp;&amp; !hasRange) {&#xA;            &#xA;            return { error: &#39;必须填写 date，或同时填写 rangeStart 和 rangeEnd&#39; };&#xA;        }&#xA;&#xA;        if (hasRangeStart !== hasRangeEnd) {&#xA;            &#xA;            return { error: &#39;rangeStart 和 rangeEnd 必须同时填写&#39; };&#xA;        }&#xA;&#xA;        if (hasRange) {&#xA;            const startDateObj = parseFixedDate(rangeStart);&#xA;            const endDateObj = parseFixedDate(rangeEnd);&#xA;&#xA;            &#xA;            &#xA;            &#xA;            &#xA;            &#xA;            &#xA;&#xA;            if (!startDateObj || !endDateObj) {&#xA;                &#xA;                return { error: &#39;rangeStart 和 rangeEnd 只能使用 YYYY-MM-DD 格式&#39; };&#xA;            }&#xA;&#xA;            if (getDaysDifference(startDateObj, endDateObj) &lt;= 0) {&#xA;                &#xA;                return { error: &#39;rangeStart 必须早于 rangeEnd&#39; };&#xA;            }&#xA;&#xA;            &#xA;            &#xA;            &#xA;            &#xA;            &#xA;            &#xA;            return {&#xA;                mode: &#39;range&#39;,&#xA;                useViewDate: false,&#xA;                startDateObj: startDateObj,&#xA;                endDateObj: endDateObj&#xA;            };&#xA;        }&#xA;&#xA;        const targetDateObj = parseFixedDate(date);&#xA;        const baseDateObj = useViewDate ? getTodayDate() : parseFixedDate(pubDate);&#xA;&#xA;        &#xA;        &#xA;        &#xA;        &#xA;        &#xA;        &#xA;&#xA;        if (!targetDateObj) {&#xA;            &#xA;            return { error: &#39;date 只能使用 YYYY-MM-DD 格式&#39; };&#xA;        }&#xA;&#xA;        &#xA;        &#xA;        &#xA;        &#xA;        &#xA;        &#xA;        return {&#xA;            mode: &#39;date&#39;,&#xA;            useViewDate: useViewDate,&#xA;            startDateObj: baseDateObj,&#xA;            endDateObj: targetDateObj&#xA;        };&#xA;    }&#xA;&#xA;    function updateDisplay() {&#xA;        &#xA;        &#xA;        &#xA;        &#xA;        if (!widget) return;&#xA;&#xA;        const counterElement = widget.querySelector(&#39;.counter-number&#39;);&#xA;        const dateInfoElement = widget.querySelector(&#39;.date-info&#39;);&#xA;        const titleElement = widget.querySelector(&#39;.countdown-title&#39;);&#xA;        const headerElement = widget.querySelector(&#39;.memorial-header&#39;);&#xA;        const config = getConfig();&#xA;&#xA;        &#xA;&#xA;        if (config.error) {&#xA;            counterElement.textContent = &#39;--&#39;;&#xA;            titleElement.textContent = &#39;倒计时参数错误&#39;;&#xA;            dateInfoElement.textContent = config.error;&#xA;            headerElement.classList.add(&#39;past&#39;);&#xA;            adjustFontSize(counterElement);&#xA;            &#xA;            &#xA;            &#xA;            &#xA;            return;&#xA;        }&#xA;&#xA;        const days = getDaysDifference(config.startDateObj, config.endDateObj);&#xA;        const isPast = days &lt; 0;&#xA;&#xA;        counterElement.textContent = Math.abs(days);&#xA;        titleElement.textContent = config.useViewDate&#xA;            ? `${title} 距今${isPast ? &#39;已经&#39; : &#39;还有&#39;}`&#xA;            : `${title} ${isPast ? &#39;已经&#39; : &#39;还有&#39;}`;&#xA;        headerElement.classList.toggle(&#39;past&#39;, isPast);&#xA;&#xA;        const baseDateText = config.useViewDate&#xA;            ? formatDateInfo(config.startDateObj, &#39;今天&#39;)&#xA;            : formatDateInfo(config.startDateObj);&#xA;        const targetDateText = formatDateInfo(config.endDateObj);&#xA;&#xA;        dateInfoElement.textContent = isPast&#xA;            ? [targetDateText, baseDateText].join(&#39; → &#39;)&#xA;            : [baseDateText, targetDateText].join(&#39; → &#39;);&#xA;&#xA;        adjustFontSize(counterElement);&#xA;        &#xA;        &#xA;        &#xA;        &#xA;        &#xA;        &#xA;        &#xA;        &#xA;    }&#xA;&#xA;    if (document.readyState === &#39;loading&#39;) {&#xA;        document.addEventListener(&#39;DOMContentLoaded&#39;, updateDisplay);&#xA;    } else {&#xA;        updateDisplay();&#xA;    }&#xA;})();&#xA;&lt;/script&gt;</description>
			</item>
